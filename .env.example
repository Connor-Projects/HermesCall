# Hermes Call — client-side configuration.
#
# Copy this file to .env and adjust values. Never commit .env.
# Telegram bot tokens, SIP secrets, AMI/ARI credentials, and device tokens
# must NEVER live in the client bundle.

# URL of the Hermes Phone Gateway (public-facing HTTPS endpoint).
# The app derives the WSS endpoint from this by replacing https:// with wss://
# and appending /ws. You can also set this directly to the WSS URL.
EXPO_PUBLIC_HERMES_GATEWAY_URL=https://hermesagent.conweb2.dpdns.org

# Optional: set to 'true' to force the mock gateway connection for UI testing.
# EXPO_PUBLIC_HERMES_GATEWAY_USE_MOCK=true

# Optional: debug, info, warn, error
EXPO_PUBLIC_LOG_LEVEL=info
